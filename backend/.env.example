# Configurazione Server Backend JamPulse
PORT=4000

# Connessione al database MongoDB (locale o container Docker)
# Per Docker Compose usare: mongodb://mongo:27017/jampulse
# Per sviluppo locale su macchina host usare: mongodb://localhost:27017/jampulse
MONGO_URI=mongodb://localhost:27017/jampulse

# Chiave segreta crittografica per la firma e verifica dei token JWT (algoritmo HS256)
JWT_SECRET=la_tua_chiave_segreta_jwt_molto_sicura

# Origine consentita per il Cross-Origin Resource Sharing (CORS)
# Es: http://localhost (con Nginx in Docker) oppure http://localhost:5173 (con Vite in locale)
CORS_ORIGIN=http://localhost:5173